{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-protected-files.sh",
            "shell": "bash",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
